{
  "manifest_version": 3,
  "name": "视频录音转文字 video2srt",
  "version": "1.0.261106.12",
  "description": "录制任意网页视频的声音（B站、腾讯视频、视频号网页版等），导出 MP3，并调用转写 API 生成 SRT 字幕，自动下载到本地。控制面板固定在侧边栏，结果实时显示；快捷键可自定义。",
  "permissions": ["tabCapture", "offscreen", "downloads", "storage", "scripting", "sidePanel", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "action": {
    "default_title": "视频录音转文字（点击开关侧边栏面板）",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "打开/关闭侧边栏面板"
    },
    "start-record": {
      "suggested_key": { "default": "Alt+S" },
      "description": "开始录制当前标签页"
    },
    "stop-record": {
      "suggested_key": { "default": "Alt+E" },
      "description": "停止录制并生成文件"
    }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
